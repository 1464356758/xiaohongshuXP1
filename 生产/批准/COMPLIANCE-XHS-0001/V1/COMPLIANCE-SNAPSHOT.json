    "prohibited_or_high_risk_claims": {
      "status": "VERIFIED",
      "rules": [
        "不得把眼影等化妆品描述为具有医疗、治疗、治愈、消炎、抗炎等医疗作用。",
        "不得作虚假或引人误解的产品性能、功效、适用人群、使用结果、时长结果或数据陈述。",
        "不得使用“100%有效”“完全有效”“绝对无风险”“所有人都适用”等保证性承诺；若内容进入商业广告范围，还应严格避免广告法意义上的绝对化用语及虚构使用效果。",
        "普通化妆品不得越权宣称仅特殊化妆品可依法主张的特定功效；当前产品为眼影，本内容应保持在颜色、搭配、审美和已核验商品事实范围。",
        "显色、持妆、不飞粉、长时不脱妆、功效/性能比较等若作为事实性性能结论，必须有当前适用证据；没有证据只能写成明确的编辑搭配建议或删除。",
        "不得把编辑建议包装成品牌官方教程，不得用未经核验的排名、销量、权威背书或竞品贬损来增强说服力。"
      ],
      "current_scope_note": "当前冻结文案核心为03水晶球的色彩结构、通勤搭配与选择建议，未依赖医疗或功效保证型claim；具体成品是否完全合规仍应由后续CONTENT_TRUTH_COMPLIANCE_REVIEW绑定exact copy+manifest逐条审核。",
      "source_ids": [
        "LAW-COSMETICS-2021",
        "PLATFORM-XHS-CONTENT-REVIEW-2026",
        "LAW-ADVERTISING-CURRENT"
      ]
    },
    "authenticity_rules": {
      "status": "VERIFIED",
      "rules": [
        "SYNTHETIC_VISUAL_PERSONA不得被写成现实产品使用主体。",
        "禁止虚构‘我买了/我收到了/我用了/我试了/我回购了/我空瓶了/我用了X天/我带妆X小时/我实测不脱妆’及等价表达。",
        "不得把聚合反馈、公开资料、品牌信息或编辑判断偷换成账号本人的现实经历。",
        "可以使用不暗示现实使用的审美观点、搭配偏好、内容组织判断，但不得让用户合理理解为虚拟人物发生了现实购买、试用或效果经历。",
        "商品名称、SKU、色号、包装及颜色事实必须继续绑定当前PRODUCT/SKU LOCK；人物视觉不得冒充真实消费者经历证据。",
        "小红书官方社区规则要求素材与分享真实、不得塑造虚假人设；系统内部PERSONA LOCK进一步将first_person_experience_eligible固定为false。"
      ],
