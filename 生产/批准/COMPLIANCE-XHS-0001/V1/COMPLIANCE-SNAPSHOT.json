  "checks": {
    "AI_label_requirement": {
      "status": "VERIFIED",
      "applicability": "APPLICABLE",
      "requirement": "当前内容明确包含AI生成/合成的文本与图片，并使用SYNTHETIC_VISUAL_PERSONA。发布时必须主动声明AI参与，并不得删除、篡改、隐藏已有生成合成标识。若小红书发布页提供专门AI标识功能，应同时使用该平台功能。",
      "platform_mechanism_evidence": "小红书官方《社区公约2.0》明确给出可执行的可见标注方式：在内容开头或结尾标注“AI生成”，或在图片简介、视频片头等处注明。当前为图文内容，至少需存在用户可明显感知的AI参与标识；发布前R13/R14还应复核当时客户端是否出现专门AI标识开关/声明入口。",
