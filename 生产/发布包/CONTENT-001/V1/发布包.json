ound_manifest_revision":1,"bound_manifest_fingerprint":"sha256:a440c035ba76f2c924cb24afb7024e30f510f5107eae7b6642d86dbaf6d78051","bound_compliance_snapshot_path":"生产/批准/COMPLIANCE-XHS-0001/V1/COMPLIANCE-SNAPSHOT.json","bound_compliance_scope_fingerprint":"sha256:1d221e6b463df3bc40498cebfbf2312f5ea54a3934e4b7430ae7fd83384c86e1","bound_r13_review_path":"生产/审核/内容合规/CONTENT-001/COMPLIANCE_REVIEW/V1/R13-内容真实性与平台合规审核.json","bound_r13_result":"PASS"},"publish_copy":{"title":"花知晓03水晶球｜冷蓝眼影怎么放进通勤妆？","body":["03水晶球第一眼最抢的是冷蓝和银蓝，但日常好不好搭，重点其实不是“蓝多不多”，而是你准备让蓝色出现多少。","这盘是 Flower Knows / 花知晓 Snow Ballet Six-Color Satin Makeup Palette 的 03 Crystal Ball / 水晶球。六个官方色名是 Frosted Pearl、Glacier Blue、Cool Taupe、Cold Brew、Silver Blue Ice、Iridescent Galaxy Blue。","如果目标是通勤，不需要把六色都塞进一个眼妆。更稳的思路是先用 Cool Taupe + Cold Brew 把灰棕结构定住，再决定蓝色只留一点，还是让冷感更明显。","想低存在感，就把蓝收住；想多一点冷感，可以加少量 Glacier Blue 或 Silver Blue Ice；想让蓝成为视觉重点，再把 Iridescent Galaxy Blue 的存在感提高。","所以选03之前，先问自己三件事：喜欢冷灰棕＋冷蓝这组关系吗？蓝色想当主角还是点缀？日常环境能接受多少闪感？答案比“蓝色眼影日不日常”更有用。"],"cta":"先收藏这张选择卡。等真的要选03时，先看自己想要的是“灰棕里一点蓝”，还是“让冷蓝直接成为重点”。","comment_prompt":"你会把蓝色留在眼尾 / 下眼睑做点缀，还是更愿意让它直接当主色？","tags":["#花知晓","#SnowBallet","#水晶球眼影","#冷蓝眼影","#通勤眼妆","#眼影盘怎么选"]},"page_order":["P1","P2","P3","P4","P5"],"assets":[{"page_id":"P1","page_number":"1/5","asset_id":"CONTENT-001-P1","asset_revision":1,"fingerprint":"sha256:7727095f04537b57652100ef79699227eff9b3b33fed3bc8a75ca172e0e878e0","immutable_attachment_id":"file_00000000ff6081fdae07c825f044d4a3","asset_ref":"user_file://file_00000000ff6081fdae07c825f044d4a3","asset_transport":"USER_FILE"},{"page_id":"P2","page_number":"2/5","asset_id":"CONTENT-001-P2","asset_revision":1,"fingerprint":"sha256:e5973a46dece0ab451d4be9171663002a190dce922bdc6be6763894917e41c72","immutable_attachment_id":"file_00000000151881fdba1749e3cf3c07c1","asset_ref":"user_file://file_00000000151881fdba1749e3cf3c07c1","asset_transport":"USER_FILE"},{"page_id":"P3","page_number":"3/5","asset_id":"CONTENT-001-P3","asset_revision":1,"fingerprint":"sha25